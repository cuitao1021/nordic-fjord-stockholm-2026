  <Document>
    <name>2026 北极圈特罗姆瑟 × 斯德哥尔摩路线 v4</name>
    <description>2026-09-29 至 2026-10-06。导入 Google My Maps 后可按文件夹查看海岸环线、Lyngen 线、Oldervik 备用线和 Stockholm 节点。</description>
    <Style id="coast"><LineStyle><color>ffb0b928</color><width>5</width></LineStyle></Style>
    <Style id="lyngen"><LineStyle><color>ffa8e075</color><width>5</width></LineStyle></Style>
    <Style id="backup"><LineStyle><color>ff67b4e4</color><width>4</width></LineStyle></Style>
    <Style id="stockholm"><LineStyle><color>ff4854b8</color><width>4</width></LineStyle></Style>
    <Style id="arcticPoint"><IconStyle><color>ff8a7808</color><scale>1.1</scale></IconStyle></Style>
    <Style id="swedenPoint"><IconStyle><color>ff3f4ba9</color><scale>1.1</scale></IconStyle></Style>
    <Folder><name>09.30 Kvaløya–Sommarøy 海岸环线</name>
      <Placemark><name>09.30 海岸环线</name><styleUrl>#coast</styleUrl><LineString><tessellate>1</tessellate><coordinates>18.9553,69.6492,0 18.6206,69.6943,0 18.5398,69.7770,0 18.0073,69.6336,0 18.5250,69.6425,0 18.9553,69.6492,0</coordinates></LineString></Placemark>
    </Folder>
    <Folder><name>10.01 Lyngen 主线</name>
      <Placemark><name>Breivikeidet–Svensby–Lyngen</name><styleUrl>#lyngen</styleUrl><LineString><tessellate>1</tessellate><coordinates>18.9553,69.6492,0 19.6333,69.6667,0 19.9033,69.6656,0 20.2189,69.5760,0 19.9033,69.6656,0 19.6333,69.6667,0 18.9553,69.6492,0</coordinates></LineString></Placemark>
    </Folder>
    <Folder><name>10.01 Oldervik 备用线</name>
      <Placemark><name>Tønsvik–Oldervik 备用</name><styleUrl>#backup</styleUrl><LineString><tessellate>1</tessellate><coordinates>18.9553,69.6492,0 19.0310,69.7650,0 19.6900,69.7550,0 19.0310,69.7650,0 18.9553,69.6492,0</coordinates></LineString></Placemark>
    </Folder>
    <Folder><name>10.02–10.05 Stockholm</name>
      <Placemark><name>Stockholm 城市节点线</name><styleUrl>#stockholm</styleUrl><LineString><tessellate>1</tessellate><coordinates>18.0708,59.3254,0 18.0914,59.3280,0 18.1200,59.3258,0 18.0544,59.3275,0 18.0578,59.3196,0 18.0790,59.3360,0</coordinates></LineString></Placemark>
    </Folder>
    <Folder><name>特罗姆瑟周边节点</name>
      <Placemark><name>01 Tromsø 港口</name><description>09.29 / 每晚；城市适应与港口散步。</description><styleUrl>#arcticPoint</styleUrl><Point><coordinates>18.9553,69.6492,0</coordinates></Point></Placemark>
      <Placemark><name>02 北极教堂</name><description>09.29 可选；外观与彩色玻璃。</description><styleUrl>#arcticPoint</styleUrl><Point><coordinates>18.9871,69.6489,0</coordinates></Point></Placemark>
      <Placemark><name>03 Fjellheisen</name><description>天气最好时；山顶能见度决定是否上缆车。</description><styleUrl>#arcticPoint</styleUrl><Point><coordinates>18.9986,69.6427,0</coordinates></Point></Placemark>
      <Placemark><name>04 Ersfjordbotn</name><description>09.30；深色峡湾与尖峰。</description><styleUrl>#arcticPoint</styleUrl><Point><coordinates>18.6206,69.6943,0</coordinates></Point></Placemark>
      <Placemark><name>05 Grøtfjord</name><description>09.30 天气好时；北向海湾与白沙。</description><styleUrl>#arcticPoint</styleUrl><Point><coordinates>18.5398,69.7770,0</coordinates></Point></Placemark>
      <Placemark><name>06 Sommarøy</name><description>09.30；白沙渔村群岛。</description><styleUrl>#arcticPoint</styleUrl><Point><coordinates>18.0073,69.6336,0</coordinates></Point></Placemark>
      <Placemark><name>07 Kattfjordeidet</name><description>09.30 回程；荒原山口，路面结冰时不停。</description><styleUrl>#arcticPoint</styleUrl><Point><coordinates>18.5250,69.6425,0</coordinates></Point></Placemark>
      <Placemark><name>08 Breivikeidet 渡轮码头</name><description>10.01 Plan A；前一晚核对 Svipper。</description><styleUrl>#arcticPoint</styleUrl><Point><coordinates>19.6333,69.6667,0</coordinates></Point></Placemark>
      <Placemark><name>09 Svensby / Lyngen Alps</name><description>10.01 Plan A；公路观景和短步行。</description><styleUrl>#arcticPoint</styleUrl><Point><coordinates>19.9033,69.6656,0</coordinates></Point></Placemark>
      <Placemark><name>10 Oldervik</name><description>10.01 Plan B；无渡轮、可随时掉头。</description><styleUrl>#arcticPoint</styleUrl><Point><coordinates>19.6900,69.7550,0</coordinates></Point></Placemark>
    </Folder>
    <Folder><name>斯德哥尔摩节点</name>
      <Placemark><name>11 Gamla Stan / Stortorget</name><description>10.02 或 10.05；老城黄昏。</description><styleUrl>#swedenPoint</styleUrl><Point><coordinates>18.0708,59.3254,0</coordinates></Point></Placemark>
      <Placemark><name>12 Vasa Museum</name><description>10.03；约 2–2.5 小时。</description><styleUrl>#swedenPoint</styleUrl><Point><coordinates>18.0914,59.3280,0</coordinates></Point></Placemark>
      <Placemark><name>13 Djurgården</name><description>10.03；运河与岛屿散步。</description><styleUrl>#swedenPoint</styleUrl><Point><coordinates>18.1200,59.3258,0</coordinates></Point></Placemark>
      <Placemark><name>14 Stockholm City Hall</name><description>10.04；预约导览或外观水岸。</description><styleUrl>#swedenPoint</styleUrl><Point><coordinates>18.0544,59.3275,0</coordinates></Point></Placemark>
      <Placemark><name>15 Monteliusvägen</name><description>10.04；日落前观景。</description><styleUrl>#swedenPoint</styleUrl><Point><coordinates>18.0578,59.3196,0</coordinates></Point></Placemark>
      <Placemark><name>16 Östermalms Saluhall</name><description>10.05；早午餐后返程。</description><styleUrl>#swedenPoint</styleUrl><Point><coordinates>18.0790,59.3360,0</coordinates></Point></Placemark>
    </Folder>
  </Document>
